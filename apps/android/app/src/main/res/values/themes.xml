<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns all chrome; the XML theme just needs to be a no-action-bar
         base that lets edge-to-edge work. Material3's XML namespace pulls in a
         dependency we don't otherwise need; the plain DeviceDefault theme is
         the right minimal base for a Compose-first app. -->
    <style name="Theme.Cascade" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Splash inherits the theme so the activity has the right background
         while it warms up the WASM-equivalent JNI library. -->
    <style name="Theme.Cascade.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0B1A24</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Cascade</item>
    </style>
</resources>
