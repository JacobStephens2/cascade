<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Cascade</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Set this to your unique app identifier when you turn on signing. -->
    <DefaultLanguage>en-US</DefaultLanguage>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.241114003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.3233" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <!-- Bundled audio asset (built from waterfall.ogg by scripts/build-asset.ps1). -->
  <ItemGroup>
    <Content Include="Assets\waterfall.mp3" Condition="Exists('Assets\waterfall.mp3')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Embed the native Rust DLL per architecture. Copied into place by
       scripts/build-rust.ps1; we don't fail the .NET build if it's missing
       so a fresh-checkout open in Visual Studio shows a helpful error rather
       than a cryptic one. -->
  <ItemGroup>
    <None Include="Native\x64\cascade_uniffi.dll"
          Condition="Exists('Native\x64\cascade_uniffi.dll') AND '$(Platform)' == 'x64'">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>cascade_uniffi.dll</Link>
    </None>
    <None Include="Native\arm64\cascade_uniffi.dll"
          Condition="Exists('Native\arm64\cascade_uniffi.dll') AND '$(Platform)' == 'arm64'">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>cascade_uniffi.dll</Link>
    </None>
  </ItemGroup>

  <!-- App icons. Placeholders generated from the existing web app icon by
       scripts/build-asset.ps1; replace with proper Square*Logo / Wide310x150
       assets before shipping a real MSIX. -->
  <ItemGroup>
    <Content Include="Assets\Square150x150Logo.png" Condition="Exists('Assets\Square150x150Logo.png')" />
    <Content Include="Assets\Square44x44Logo.png" Condition="Exists('Assets\Square44x44Logo.png')" />
    <Content Include="Assets\StoreLogo.png" Condition="Exists('Assets\StoreLogo.png')" />
    <Content Include="Assets\SplashScreen.png" Condition="Exists('Assets\SplashScreen.png')" />
    <Content Include="Assets\Wide310x150Logo.png" Condition="Exists('Assets\Wide310x150Logo.png')" />
    <Content Include="Assets\LockScreenLogo.png" Condition="Exists('Assets\LockScreenLogo.png')" />
  </ItemGroup>
</Project>
