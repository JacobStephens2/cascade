<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  IgnorableNamespaces="uap uap5 rescap desktop">

  <Identity
    Name="page.stephens.cascade"
    Publisher="CN=Stephens Page"
    Version="0.1.0.0" />

  <mp:PhoneIdentity PhoneProductId="3a1a2b3c-4d5e-6f70-8192-a3b4c5d6e7f8" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>Cascade</DisplayName>
    <PublisherDisplayName>Stephens Page</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us"/>
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="Cascade"
        Description="A native waterfall focus / sleep sound player."
        BackgroundColor="#0B1A24"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
        <uap:LockScreen BadgeLogo="Assets\LockScreenLogo.png" Notification="badge"/>
      </uap:VisualElements>

      <!-- Launch at login. Enabled by the user from the Settings page via
           StartupTask.GetAsync("CascadeStartup").RequestEnableAsync(). -->
      <Extensions>
        <desktop:Extension Category="windows.startupTask" Executable="Cascade.exe"
                           EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="CascadeStartup" Enabled="false" DisplayName="Cascade" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Intentionally no internetClient — Cascade has zero network needs.
         runFullTrust covers SetThreadExecutionState (P/Invoke) and tray icon
         interop when that ships. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
