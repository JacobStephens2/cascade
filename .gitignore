.gradle/
local.properties
build/
*.iml

# Large source audio (WAV is the working master; OGG/MP3 are committed)
assets/*.wav
target-android/

# Release binaries dropped into the downloads page (hosted, not version-tracked)
apps/web/public/downloads/*.exe
apps/web/public/downloads/*.msix
apps/web/public/downloads/*.zip

